# ---------------------------------------------------------------------------
# WebsiteX-Ray environment configuration
# Copy this file to `.env` and fill in the values. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/websitexray?schema=public"

# --- Redis (optional, used for job queue + rate limiting) -------------------
# If unset, the app falls back to an in-memory queue (dev only).
REDIS_URL="redis://localhost:6379"

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ---------------------------------------------------------------------------
# AI PROVIDER ABSTRACTION
# The analysis engine never talks to a provider directly. It calls the
# abstraction configured below. Switch providers by changing AI_PROVIDER only.
# ---------------------------------------------------------------------------

# One of: "ollama" | "openai" | "disabled"
AI_PROVIDER="ollama"

# --- Ollama (local AI) ------------------------------------------------------
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1"

# --- OpenAI-compatible API --------------------------------------------------
# Works with OpenAI, Together, Groq, OpenRouter, local vLLM, etc.
# Keys are read from the environment ONLY. Never hard-code them in source.
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ---------------------------------------------------------------------------
# CRAWLER / ANALYSIS SAFETY LIMITS (SSRF protection & resource guards)
# ---------------------------------------------------------------------------
CRAWLER_MAX_PAGES="10"
CRAWLER_MAX_DEPTH="2"
CRAWLER_REQUEST_TIMEOUT_MS="15000"
CRAWLER_MAX_RESPONSE_BYTES="10485760"
CRAWLER_USER_AGENT="WebsiteX-RayBot/1.0 (+https://websitexray.app/bot)"
# Set to "true" ONLY in trusted local dev to allow private IPs.
CRAWLER_ALLOW_PRIVATE_IPS="false"

# --- Artifact storage -------------------------------------------------------
# Where screenshots + generated PDFs are written. In containers, point this at
# a mounted persistent disk (e.g. /app/.data). Unset = local ./.screenshots
# and ./.reports for dev.
# ARTIFACT_DIR="/app/.data"
