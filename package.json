{
  "name": "websitex-ray",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered website analysis and auditing platform",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "start:prod": "prisma db push --schema prisma/schema.prisma --skip-generate --accept-data-loss && next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:dev:sync": "node scripts/gen-sqlite-schema.mjs",
    "db:dev:push": "npm run db:dev:sync && prisma db push --schema prisma/schema.sqlite.prisma",
    "worker": "tsx src/worker/index.ts"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "axe-core": "^4.13.0",
    "cheerio": "^1.2.0",
    "chrome-launcher": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ioredis": "^5.4.2",
    "lighthouse": "^13.4.1",
    "lucide-react": "^0.469.0",
    "next": "^16.3.5",
    "next-themes": "^0.4.4",
    "playwright": "^1.63.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.3.5",
    "postcss": "^8.4.49",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
